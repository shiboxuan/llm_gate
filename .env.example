# LLM Gate 配置示例
# 复制为 .env 并修改为实际值。所有变量前缀 LLM_GATE_。

# 应用配置
LLM_GATE_APP_NAME=llm-gate
LLM_GATE_APP_ENV=production
LLM_GATE_DEBUG=false

# 数据库（PostgreSQL，SQLAlchemy 异步直连）
LLM_GATE_DATABASE_URL=postgresql+asyncpg://llm_gate:llm_gate@localhost:5432/llm_gate

# Redis
LLM_GATE_REDIS_URL=redis://localhost:6379/0
LLM_GATE_REDIS_CACHE_TTL=36000

# JWT 配置（必须修改为随机长字符串）
LLM_GATE_JWT_SECRET_KEY=please-change-this-to-a-random-secret
LLM_GATE_JWT_ALGORITHM=HS256
LLM_GATE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# AES 加密密钥（用于 Provider Key 加密，必须修改为 32 字节随机字符串）
LLM_GATE_AES_SECRET_KEY=please-change-this-to-a-32-byte-secret

# 预置管理员（首次启动时自动创建）
LLM_GATE_ADMIN_USERNAME=gate_admin
LLM_GATE_ADMIN_PASSWORD=please-change-this-to-a-strong-password

# Anthropic 代理 Bearer 认证标识（可选，默认空；自建 Bearer 认证代理时配置 base_url 中出现的标识字符串）
# 多个标识用 JSON 数组格式，例如：LLM_GATE_ANTHROPIC_BEARER_AUTH_MARKERS=["your-proxy-marker"]
# LLM_GATE_ANTHROPIC_BEARER_AUTH_MARKERS=[]

# Graylog 日志（可选，默认关闭）
LLM_GATE_GRAYLOG_ENABLED=false
LLM_GATE_GRAYLOG_HOST=localhost
LLM_GATE_GRAYLOG_PORT=12201
LLM_GATE_GRAYLOG_PROTOCOL=tcp
LLM_GATE_GRAYLOG_LEVEL=INFO

# HTTP 代理超时配置（秒）
LLM_GATE_PROXY_TIMEOUT_CONNECT=10.0
LLM_GATE_PROXY_TIMEOUT_WRITE=30.0
LLM_GATE_PROXY_TIMEOUT_POOL=10.0
LLM_GATE_PROXY_TIMEOUT_READ_STREAM=600.0
LLM_GATE_PROXY_TIMEOUT_READ_NON_STREAM=1800.0
