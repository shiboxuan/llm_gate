# ============================================================
# LLM Gate Frontend Environment Variables
# Copy to .env and adjust values as needed
# ============================================================

# LLM Gate backend host, used as the axios baseURL for API requests (control plane).
# - Development: use "/" (same-origin, requires dev-server proxy) or a full URL like http://localhost:9981
# - Production: use "/" (same-origin, served by the backend static hosting)
# Note: this does NOT affect the "Backend API address" shown in the onboarding guide.
# That display value auto-derives from window.location.origin + '/v1', optionally
# overridden by the backend env LLM_GATE_PUBLIC_API_BASE_URL.
LLM_GATE_HOST=/

# Webpack publicPath for static assets. Use "/" for same-origin hosting.
PUBLIC_PATH=/
