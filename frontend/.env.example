# ============================================================
# LLM Gate Frontend Environment Variables
# Copy to .env and adjust values as needed
# ============================================================

# LLM Gate backend host.
# - Development: use "/" (same-origin, requires dev-server proxy) or a full URL like http://localhost:9981
# - Production: use "/" (same-origin, served by the backend static hosting)
LLM_GATE_HOST=/

# Webpack publicPath for static assets. Use "/" for same-origin hosting.
PUBLIC_PATH=/
