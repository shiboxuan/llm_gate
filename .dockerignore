# 版本控制 / IDE / 工具
.git
.gitignore
.idea
.claude
.DS_Store

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 环境变量：.env.production 在 build 时拷进镜像供运行时读取；.env / .env.*.local 不进镜像
.env
.env.*.local

# 前端：本地依赖与构建产物（镜像内由 Stage 1 重新 npm ci + npm run build）
frontend/node_modules/
frontend/build/
frontend/.cache/

# 本地 static 软链接（镜像内由 Dockerfile 从前端构建产物生成）
/static

# 测试 / 文档 / 调试脚本（镜像不需要）
tests/
docs/
scratch/
*.scratch.py
debug_embeddings.py
DockerfileDebug
